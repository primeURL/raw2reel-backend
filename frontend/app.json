{
  "expo": {
    "name": "Raw2Reel",
    "slug": "raw2reel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "raw2reel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Raw2Reel uses the videos you pick to learn your editing style and make your reels."
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Raw2Reel uses the videos you pick to learn your editing style and make your reels.",
          "savePhotosPermission": "Raw2Reel saves your finished reels to your gallery.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Raw2Reel listens only while you hold the mic, to type your script for you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
