# Copy to .env (Expo loads it automatically). EXPO_PUBLIC_* values are bundled into the app - no secrets here.
# iOS simulator / web: localhost. A real phone: your Mac's LAN IP (ipconfig getifaddr en0).
EXPO_PUBLIC_API_URL=http://localhost:8000
# Dev sign-in against the backend's AUTH_DEV_BYPASS (always on in development builds)
EXPO_PUBLIC_DEV_LOGIN=true
