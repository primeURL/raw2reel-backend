# Copy to .env and fill in. Never commit .env.

APP_ENV=dev                      # dev | prod
API_CORS_ORIGINS=*               # comma-separated in prod

# Postgres (docker-compose builds DATABASE_URL from these)
POSTGRES_USER=raw2reel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=raw2reel

# Firebase Auth (Google sign-in). Download the service-account JSON from
# Firebase console > Project settings > Service accounts, save it as
# backend/secrets/firebase-service-account.json (mounted read-only).
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-service-account.json
# Local testing only: accept "Authorization: Bearer dev:<uid>" (ignored when APP_ENV=prod)
AUTH_DEV_BYPASS=false

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=raw2reel
R2_PRESIGN_EXPIRES_SECONDS=3600

# Instagram reference import
# Optional Netscape cookies.txt of a dedicated Instagram account (NOT a personal one);
# public reels often need a logged-in session. Put it in backend/secrets/.
INSTAGRAM_COOKIES_FILE=
INSTAGRAM_MAX_DURATION_SECONDS=180
INSTAGRAM_MAX_FILESIZE_MB=200
# Optional paid fallback (e.g. an Apify actor) - leave empty to disable
INSTAGRAM_FALLBACK_API_URL=
INSTAGRAM_FALLBACK_API_TOKEN=

# Claude (style analysis + edit plans), used from Day 4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=20                # AI calls per user per day
